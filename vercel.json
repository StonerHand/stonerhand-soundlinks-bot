{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/telegram.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/set_webhook.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/health.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/queue_worker.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/collage.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/smoke.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/telegram",
      "dest": "api/telegram.py"
    },
    {
      "src": "/api/set_webhook",
      "dest": "api/set_webhook.py"
    },
    {
      "src": "/api/health",
      "dest": "api/health.py"
    },
    {
      "src": "/api/queue_worker",
      "dest": "api/queue_worker.py"
    },
    {
      "src": "/api/collage",
      "dest": "api/collage.py"
    },
    {
      "src": "/api/smoke",
      "dest": "api/smoke.py"
    }
  ],
  "crons": [
    {
      "path": "/api/set_webhook",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/queue_worker",
      "schedule": "5 3 * * *"
    }
  ]
}
