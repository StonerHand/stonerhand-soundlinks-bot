# Required
BOT_TOKEN=replace-me

# Release discovery (legacy Songlink API key is optional)
SONGLINK_API_KEY=
SONGLINK_USER_COUNTRIES=US
PRIMARY_PLATFORM=spotify

# Publishing and administration
ADMIN_CHAT_ID=
PUBLISH_CHAT_ID=
BOT_TIMEZONE=Europe/Moscow

# Vercel webhook
SET_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=
CRON_SECRET=

# Durable production state (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy Vercel KV aliases (optional)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Telegram delivery features
BOT_UI_MODE=stonerhand
EPHEMERAL_GROUP_REPLIES=1
BOT_SAFE_MODE=0
RICH_MESSAGES_ENABLED=1
RICH_DRAFTS_ENABLED=1
INLINE_RICH_MEDIA_ENABLED=1
COLLECTION_COLLAGE_ENABLED=1

# Optional native custom emoji for the private bot interface. Leave blank to
# keep the complete built-in emoji fallback. Telegram applies its own Premium
# and additional-username eligibility rules.
TELEGRAM_BUTTON_ICON_TRACK_ID=
TELEGRAM_BUTTON_ICON_ALBUM_ID=
TELEGRAM_BUTTON_ICON_RADIO_ID=
TELEGRAM_BUTTON_ICON_COLLECTION_ID=
TELEGRAM_BUTTON_ICON_HUB_ID=
TELEGRAM_BUTTON_ICON_EXTERNAL_ID=
TELEGRAM_BUTTON_ICON_ADD_ID=
TELEGRAM_BUTTON_ICON_READY_ID=
TELEGRAM_BUTTON_ICON_WARNING_ID=
TELEGRAM_BUTTON_ICON_SHARE_ID=

# Optional classic-photo branding
BRAND_PHOTO_FRAME=0
BRAND_LOGO_URL=
BRAND_LABEL=

# Diagnostics
LOG_LEVEL=INFO
STATS_PATH=
