# Required
BOT_TOKEN=replace-me

# Release discovery
SONGLINK_API_KEY=
SONGLINK_USER_COUNTRIES=US
PRIMARY_PLATFORM=spotify

# Publishing and administration
ADMIN_CHAT_ID=
PUBLISH_CHAT_ID=
BOT_TIMEZONE=Europe/Moscow

# Vercel webhook
SET_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=
CRON_SECRET=

# Durable production state (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy Vercel KV aliases (optional)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Telegram delivery features
BOT_UI_MODE=stonerhand
EPHEMERAL_GROUP_REPLIES=0
BOT_SAFE_MODE=0
RICH_MESSAGES_ENABLED=1
RICH_DRAFTS_ENABLED=0
INLINE_RICH_MEDIA_ENABLED=1

# Optional classic-photo branding
BRAND_PHOTO_FRAME=0
BRAND_LOGO_URL=
BRAND_LABEL=

# Diagnostics
LOG_LEVEL=INFO
STATS_PATH=
